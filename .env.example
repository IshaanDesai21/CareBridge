# ── Backend (backend/.env) ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Postgres connection string (Neon, local Postgres, etc.)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Encrypts health data at rest (AES-256-GCM). Use a long random value, e.g.
# `openssl rand -base64 48`. Back it up: if it's lost, encrypted data is unreadable.
DATA_ENCRYPTION_KEY=

# Comma-separated list of allowed origins (or * for any)
CORS_ORIGIN=http://localhost:5173

# Google OAuth client IDs from Google Cloud Console, used to verify
# "Sign in with Google" ID tokens from the web dashboard and iOS app
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# AI chat / medication scanning (NVIDIA-hosted model)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Dashboard (dashboard/.env) ───────────────────────────────────────────────
# VITE_API_URL=https://api.carebridge.ftcblueprint.com
# VITE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
